@page
@model HotelReservation.Web.Pages.Employees.CreateModel
@using HotelReservation.Web.Helpers
@{
    ViewData["Title"] = "New Employee";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Employees\">Employees</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Create</li>";
}

<div class="page-header">
    <h1><i class="bi bi-person-plus text-primary"></i> New Employee</h1>
</div>

<form method="post">
    <div class="card">
        <div class="card-body">
            <h6 class="form-section-title"><i class="bi bi-person"></i> Personal Information</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label asp-for="Employee.FirstName" class="form-label"></label>
                    <input asp-for="Employee.FirstName" class="form-control" placeholder="First name" />
                    <span asp-validation-for="Employee.FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Employee.LastName" class="form-label"></label>
                    <input asp-for="Employee.LastName" class="form-control" placeholder="Last name" />
                    <span asp-validation-for="Employee.LastName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Employee.Email" class="form-label"></label>
                    <input asp-for="Employee.Email" class="form-control" placeholder="email@example.com" type="email" />
                    <span asp-validation-for="Employee.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Employee.Phone" class="form-label"></label>
                    <input asp-for="Employee.Phone" class="form-control" placeholder="+1 555 000 0000" />
                    <span asp-validation-for="Employee.Phone" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="form-section-title"><i class="bi bi-briefcase"></i> Employment Details</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Employee.HotelID" class="form-label">Hotel</label>
                    <select asp-for="Employee.HotelID" class="form-select" asp-items="Model.Hotels">
                        <option value="">-- Select Hotel --</option>
                    </select>
                    <span asp-validation-for="Employee.HotelID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Employee.DepartmentID" class="form-label">Department</label>
                    <select asp-for="Employee.DepartmentID" class="form-select" asp-items="Model.Departments">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="Employee.DepartmentID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Employee.Position" class="form-label"></label>
                    <select asp-for="Employee.Position" class="form-select">
                        <option value="">-- Select Position --</option>
                        @foreach (var pos in StatusUi.EmployeePositions)
                        {
                            <option value="@pos">@pos</option>
                        }
                    </select>
                    <span asp-validation-for="Employee.Position" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Employee.Salary" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Employee.Salary" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Employee.Salary" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light d-flex justify-content-end gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Employee</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
