@page "{id:int}"
@model HotelReservation.Web.Pages.Employees.DetailsModel
@{
    ViewData["Title"] = "Employee Details";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Employees\">Employees</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Details</li>";
}

@if (Model.Employee == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Employee not found.</p></div>
    return;
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width:56px;height:56px;font-size:1.4rem;font-weight:700;">
            @(Model.Employee.FirstName.FirstOrDefault())@(Model.Employee.LastName.FirstOrDefault())
        </div>
        <div>
            <h1><i class="bi bi-person-badge text-primary"></i> @Model.Employee.FullName</h1>
            <p class="text-muted mb-0">
                <span class="badge bg-primary bg-opacity-10 text-primary me-1">@Model.Employee.Position</span>
                @if (!string.IsNullOrEmpty(Model.Employee.HotelName))
                {
                    <span class="text-muted"><i class="bi bi-building"></i> @Model.Employee.HotelName</span>
                }
            </p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Employee.EmployeeID" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-card-list text-primary"></i> Employee Information</h5></div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Employee ID</div>
                    <div class="col-sm-8"><strong>#@Model.Employee.EmployeeID</strong></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Full Name</div>
                    <div class="col-sm-8">@Model.Employee.FullName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Position</div>
                    <div class="col-sm-8"><span class="badge bg-primary bg-opacity-10 text-primary">@Model.Employee.Position</span></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Hotel</div>
                    <div class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Employee.HotelName))
                        {
                            <span><i class="bi bi-building"></i> @Model.Employee.HotelName</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Department</div>
                    <div class="col-sm-8">@(Model.Employee.DepartmentName ?? "—")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Salary</div>
                    <div class="col-sm-8 fw-semibold">@Model.Employee.Salary.ToString("C")</div>
                </div>
                <hr />
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Email</div>
                    <div class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Employee.Email))
                        {
                            <span><i class="bi bi-envelope"></i> @Model.Employee.Email</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Phone</div>
                    <div class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Employee.Phone))
                        {
                            <span><i class="bi bi-telephone"></i> @Model.Employee.Phone</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted">Hire Date</div>
                    <div class="col-sm-8">@Model.Employee.HireDate.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="stat-value text-primary">@Model.Employee.Salary.ToString("C0")</div>
                        <div class="stat-label">Annual Salary</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0">Quick Actions</h6></div>
            <div class="card-body d-grid gap-2">
                <a asp-page="./Edit" asp-route-id="@Model.Employee.EmployeeID" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i> Edit Employee</a>
                <a asp-page="./Delete" asp-route-id="@Model.Employee.EmployeeID" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete Employee</a>
                <a asp-page="/Reservations/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-calendar-check"></i> View Reservations</a>
            </div>
        </div>
    </div>
</div>
