@page "{statusCode:int?}"
@model ErrorModel
@{
    var code = Model.ErrorCode;
    ViewData["Title"] = code > 0 ? $"Error {code}" : "Error";
    var title = code switch
    {
        404 => "Page Not Found",
        403 => "Access Denied",
        401 => "Unauthorized",
        >= 500 => "Server Error",
        _ => "Something Went Wrong"
    };
    var icon = code switch
    {
        404 => "bi-compass",
        403 => "bi-shield-lock",
        401 => "bi-lock",
        >= 500 => "bi-exclamation-triangle",
        _ => "bi-bug"
    };
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body p-5">
                <div class="display-1 text-primary mb-3">
                    <i class="bi @icon"></i>
                </div>
                @if (code > 0)
                {
                    <h1 class="display-5 fw-bold mb-2">@code</h1>
                }
                <h3 class="fw-bold text-dark mb-3">@title</h3>
                <p class="text-muted mb-4">
                    @if (code == 404)
                    {
                        <text>The page or record you are looking for does not exist or may have been moved.</text>
                    }
                    else if (code == 403 || code == 401)
                    {
                        <text>You do not have permission to access this resource. Please sign in with an authorized account.</text>
                    }
                    else
                    {
                        <text>An unexpected error occurred while processing your request. Our team has been notified.</text>
                    }
                </p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-warning text-start">
                        <i class="bi bi-info-circle"></i> @Model.ErrorMessage
                    </div>
                }

                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a href="/" class="btn btn-primary"><i class="bi bi-house-door"></i> Back to Dashboard</a>
                    <button onclick="history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Go Back</button>
                </div>
            </div>
        </div>
    </div>
</div>
