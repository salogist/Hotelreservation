@page
@model HotelReservation.Web.Pages.Hotels.DetailsModel
@{
    ViewData["Title"] = "Hotel Details";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Hotels\">Hotels</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Details</li>";
}

@if (Model.Hotel == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Hotel not found.</p></div>
    return;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-building text-primary"></i> @Model.Hotel.HotelName</h1>
        <p class="text-muted mb-0"><i class="bi bi-geo-alt"></i> @Model.Hotel.Address, @Model.Hotel.City, @Model.Hotel.Country</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Hotel.HotelID" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-card-list text-primary"></i> Property Information</h5></div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Rating</div>
                    <div class="col-sm-8">
                        @for (int i = 0; i < 5; i++)
                        {
                            <i class="bi bi-star-fill @(i < Model.Hotel.Rating ? "text-warning" : "text-muted opacity-25")"></i>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Phone</div>
                    <div class="col-sm-8"><i class="bi bi-telephone"></i> @Model.Hotel.Phone</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Email</div>
                    <div class="col-sm-8"><i class="bi bi-envelope"></i> @(Model.Hotel.Email ?? "—")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Total Rooms (capacity)</div>
                    <div class="col-sm-8"><span class="badge bg-primary">@Model.Hotel.TotalRooms</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-value text-primary">@Model.Hotel.RoomCount</div>
                        <div class="stat-label">Rooms</div>
                    </div>
                    <div class="col-6">
                        <div class="stat-value text-success">@Model.Hotel.EmployeeCount</div>
                        <div class="stat-label">Staff</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0">Quick Actions</h6></div>
            <div class="card-body d-grid gap-2">
                <a asp-page="/Rooms/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-door-open"></i> Manage Rooms</a>
                <a asp-page="/Employees/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-person-badge"></i> Manage Staff</a>
            </div>
        </div>
    </div>
</div>
