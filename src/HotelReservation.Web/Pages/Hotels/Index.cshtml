@page
@model HotelReservation.Web.Pages.Hotels.IndexModel
@using HotelReservation.Web.Helpers
@{
    ViewData["Title"] = "Hotels";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item active\" aria-current=\"page\">Hotels</li>";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-buildings text-primary"></i> Hotels</h1>
        <p class="text-muted mb-0">@Model.TotalItems hotel(s) registered</p>
    </div>
    <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Hotel</a>
</div>

<div class="card table-card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-7">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by hotel name, city or country..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-sm-3">
                <label class="form-label">Sort by</label>
                <select name="sortOrder" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Name (A-Z)</option>
                    <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Name (Z-A)</option>
                    <option value="city" selected="@(Model.SortOrder == "city")">City (A-Z)</option>
                    <option value="rating_desc" selected="@(Model.SortOrder == "rating_desc")">Rating (High-Low)</option>
                </select>
            </div>
            <div class="col-sm-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Apply</button>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.Hotels.Any())
        {
            <div class="empty-state">
                <i class="bi bi-building-slash"></i>
                <h5>No hotels found</h5>
                <p class="mb-3">Get started by adding your first hotel property.</p>
                <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Hotel</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Hotel</th>
                            <th>Location</th>
                            <th>Contact</th>
                            <th>Rating</th>
                            <th>Rooms</th>
                            <th>Staff</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Hotels)
                        {
                            <tr>
                                <td><strong>#@h.HotelID</strong></td>
                                <td>
                                    <div class="fw-semibold">@h.HotelName</div>
                                    <small class="text-muted">@h.Address</small>
                                </td>
                                <td>@h.City, @h.Country</td>
                                <td>
                                    <div><i class="bi bi-telephone"></i> @h.Phone</div>
                                    @if (!string.IsNullOrEmpty(h.Email))
                                    {
                                        <small class="text-muted"><i class="bi bi-envelope"></i> @h.Email</small>
                                    }
                                </td>
                                <td>
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="bi bi-star-fill @(i < h.Rating ? "text-warning" : "text-muted opacity-25")"></i>
                                    }
                                </td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary">@h.RoomCount</span></td>
                                <td><span class="badge bg-success bg-opacity-10 text-success">@h.EmployeeCount</span></td>
                                <td class="text-end">
                                    <a asp-page="./Details" asp-route-id="@h.HotelID" class="btn btn-icon btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                    <a asp-page="./Edit" asp-route-id="@h.HotelID" class="btn btn-icon btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-page="./Delete" asp-route-id="@h.HotelID" class="btn btn-icon btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <partial name="_Pagination" />
        </div>
    }
</div>
