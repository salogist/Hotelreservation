@page
@model IndexModel
@using HotelReservation.Web.Helpers
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-speedometer2 text-primary"></i> Dashboard</h1>
        <p class="text-muted mb-0">Welcome back! Here's what's happening across your properties today.</p>
    </div>
    <div class="text-muted">
        <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
    </div>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card card-stat h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Hotels</div>
                    <div class="stat-value text-primary">@Model.TotalHotels</div>
                    <small class="text-muted">@Model.TotalRooms total rooms</small>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-buildings"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-stat h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Reservations</div>
                    <div class="stat-value text-info">@Model.TotalReservations</div>
                    <small class="text-success"><i class="bi bi-arrow-up-short"></i>@Model.ConfirmedCount confirmed</small>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-calendar-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-stat h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Customers</div>
                    <div class="stat-value text-success">@Model.TotalCustomers</div>
                    <small class="text-muted">Registered guests</small>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-stat h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Revenue (This Month)</div>
                    <div class="stat-value text-warning">@Model.MonthlyRevenue.ToString("C0")</div>
                    <small class="text-muted">@Model.TotalRevenue.ToString("C0") total</small>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-cash-coin"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Charts row -->
<div class="row g-3 mb-4">
    <div class="col-xl-8">
        <div class="card table-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-graph-up-arrow text-primary"></i> Revenue Trend</h5>
                <span class="badge bg-light text-muted">Monthly</span>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card table-card h-100">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pie-chart text-primary"></i> Reservation Status</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Room occupancy + recent reservations -->
<div class="row g-3 mb-4">
    <div class="col-xl-4">
        <div class="card table-card h-100">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-door-closed text-primary"></i> Room Occupancy</h5>
            </div>
            <div class="card-body">
                <canvas id="occupancyChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card table-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history text-primary"></i> Recent Reservations</h5>
                <a asp-page="/Reservations/Index" class="btn btn-sm btn-outline-primary">View All <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Customer</th>
                                <th>Room</th>
                                <th>Check-In</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentReservations.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">No reservations yet</td></tr>
                            }
                            @foreach (var r in Model.RecentReservations)
                            {
                                <tr>
                                    <td><strong>#@r.ReservationID</strong></td>
                                    <td>@r.CustomerName</td>
                                    <td><span class="badge bg-light text-dark">@r.RoomNumber</span> <small class="text-muted">@r.HotelName</small></td>
                                    <td>@r.CheckInDate.ToString("MMM dd")</td>
                                    <td><span class="badge @StatusUi.ReservationBadge(r.ReservationStatus)">@r.ReservationStatus</span></td>
                                    <td class="text-end fw-semibold">@r.TotalAmount.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Popular services + latest customers -->
<div class="row g-3">
    <div class="col-xl-6">
        <div class="card table-card h-100">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-trophy text-primary"></i> Popular Services</h5>
            </div>
            <div class="card-body">
                @if (!Model.PopularServices.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p class="mb-0">No services have been booked yet</p>
                    </div>
                }
                else
                {
                    @foreach (var s in Model.PopularServices)
                    {
                        var max = Model.PopularServices.Max(x => x.TimesOrdered);
                        var pct = max > 0 ? s.TimesOrdered * 100 / max : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="bi bi-cone-striped text-secondary"></i> @s.ServiceName <small class="text-muted">(@s.Category)</small></span>
                                <span class="fw-semibold">@s.TimesOrdered&times; &middot; @s.Revenue.ToString("C0")</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-primary" style="width: @pct%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card table-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-person-plus text-primary"></i> Latest Customers</h5>
                <a asp-page="/Customers/Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr><th>Customer</th><th>Email</th><th>Joined</th></tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentCustomers.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">No customers yet</td></tr>
                            }
                            @foreach (var c in Model.RecentCustomers)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar-sm">@($"{(c.FirstName.Length > 0 ? c.FirstName[..1] : "")}{(c.LastName.Length > 0 ? c.LastName[..1] : "")}")</span>
                                            <div>@c.FirstName @c.LastName</div>
                                        </div>
                                    </td>
                                    <td class="text-muted">@c.Email</td>
                                    <td><small>@c.RegistrationDate.ToString("MMM dd, yyyy")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-sm {
        width: 32px; height: 32px; border-radius: 50%;
        background: #e0e7ff; color: #4338ca;
        display: grid; place-items: center;
        font-weight: 700; font-size: .75rem;
    }
</style>

@section Scripts {
    <script>
        // Revenue trend (line)
        (function () {
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => $"{r.MonthName?.Substring(0,3)} {r.Year}")));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => r.Revenue)));

            new Chart(document.getElementById('revenueChart'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Revenue',
                        data: data,
                        borderColor: '#4f46e5',
                        backgroundColor: 'rgba(79, 70, 229, 0.1)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2,
                        pointBackgroundColor: '#4f46e5',
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { ticks: { callback: function(v){ return '$' + v; } } } }
                }
            });

            // Reservation status (doughnut)
            new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Confirmed', 'Cancelled', 'Completed'],
                    datasets: [{
                        data: [@Model.PendingCount, @Model.ConfirmedCount, @Model.CancelledCount, @Model.CompletedCount],
                        backgroundColor: ['#facc15', '#22c55e', '#ef4444', '#94a3b8']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom' } } }
            });

            // Room occupancy (bar)
            new Chart(document.getElementById('occupancyChart'), {
                type: 'bar',
                data: {
                    labels: ['Available', 'Occupied', 'Maintenance'],
                    datasets: [{
                        data: [@Model.AvailableRooms, @Model.OccupiedRooms, @Model.MaintenanceRooms],
                        backgroundColor: ['#22c55e', '#0ea5e9', '#94a3b8']
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } }
                }
            });
        })();
    </script>
}
