@page "{id:int}"
@model HotelReservation.Web.Pages.Payments.DetailsModel
@using HotelReservation.Web.Helpers
@{
    ViewData["Title"] = "Payment Details";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Payments\">Payments</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Details</li>";
}

@if (Model.Payment == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Payment not found.</p></div>
    return;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-credit-card text-primary"></i> Payment #@Model.Payment.PaymentID</h1>
        <p class="text-muted mb-0">
            Reservation #@Model.Payment.ReservationID &middot; @Model.Payment.CustomerName
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Payment.PaymentID" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <div class="stat-value text-success mb-1">@Model.Payment.Amount.ToString("C2")</div>
                <div class="stat-label">Payment Amount</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <div class="mb-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary fs-6 px-3 py-2">
                        <i class="bi bi-@(Model.Payment.PaymentMethod switch { "Cash" => "cash", "CreditCard" => "credit-card", "DebitCard" => "credit-card-2-front", "OnlinePayment" => "globe", "BankTransfer" => "bank", _ => "wallet2" })"></i>
                        @Model.Payment.PaymentMethod
                    </span>
                </div>
                <div class="stat-label">Payment Method</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <div class="mb-2">
                    <span class="badge @StatusUi.PaymentBadge(Model.Payment.PaymentStatus) fs-6 px-3 py-2">
                        @Model.Payment.PaymentStatus
                    </span>
                </div>
                <div class="stat-label">Payment Status</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-card-list text-primary"></i> Payment Information</h5></div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Payment ID</div>
                    <div class="col-sm-8"><strong>#@Model.Payment.PaymentID</strong></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Reservation ID</div>
                    <div class="col-sm-8">
                        <a asp-page="/Reservations/Details" asp-route-id="@Model.Payment.ReservationID">#@Model.Payment.ReservationID</a>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Transaction Reference</div>
                    <div class="col-sm-8"><code>@(Model.Payment.TransactionReference ?? "—")</code></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Payment Date</div>
                    <div class="col-sm-8"><i class="bi bi-calendar"></i> @Model.Payment.PaymentDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Reservation Total</div>
                    <div class="col-sm-8 fw-semibold">@(Model.Payment.ReservationTotal?.ToString("C2") ?? "—")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Guest & Room</h6></div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">Customer</div>
                    <div class="fw-semibold"><i class="bi bi-person"></i> @(Model.Payment.CustomerName ?? "—")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Hotel</div>
                    <div class="fw-semibold"><i class="bi bi-building"></i> @(Model.Payment.HotelName ?? "—")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Room Number</div>
                    <div class="fw-semibold"><i class="bi bi-door-open"></i> @(Model.Payment.RoomNumber ?? "—")</div>
                </div>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0">Quick Actions</h6></div>
            <div class="card-body d-grid gap-2">
                <a asp-page="./Edit" asp-route-id="@Model.Payment.PaymentID" class="btn btn-outline-warning btn-sm"><i class="bi bi-pencil"></i> Edit Payment</a>
                <a asp-page="/Reservations/Details" asp-route-id="@Model.Payment.ReservationID" class="btn btn-outline-primary btn-sm"><i class="bi bi-calendar-check"></i> View Reservation</a>
            </div>
        </div>
    </div>
</div>
