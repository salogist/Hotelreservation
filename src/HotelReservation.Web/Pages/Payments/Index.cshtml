@page
@model HotelReservation.Web.Pages.Payments.IndexModel
@using HotelReservation.Web.Helpers
@{
    ViewData["Title"] = "Payments";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item active\" aria-current=\"page\">Payments</li>";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-credit-card text-primary"></i> Payments</h1>
        <p class="text-muted mb-0">@Model.TotalItems payment(s) found</p>
    </div>
    <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Payment</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-3">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="stat-value text-success">@Model.Payments.Count(p => p.PaymentStatus == "Paid")</div>
                    <div class="stat-label">Paid</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="stat-value text-warning">@Model.Payments.Count(p => p.PaymentStatus == "Pending")</div>
                    <div class="stat-label">Pending</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-pie-chart"></i>
                </div>
                <div>
                    <div class="stat-value text-info">@Model.Payments.Count(p => p.PaymentStatus == "Partial")</div>
                    <div class="stat-label">Partial</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </div>
                <div>
                    <div class="stat-value text-danger">@Model.Payments.Count(p => p.PaymentStatus == "Refunded")</div>
                    <div class="stat-label">Refunded</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label class="form-label">Status</label>
                <select name="statusFilter" class="form-select" asp-items="Model.StatusList">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-sm-4">
                <label class="form-label">Payment Method</label>
                <select name="methodFilter" class="form-select" asp-items="Model.MethodList">
                    <option value="">All Methods</option>
                </select>
            </div>
            <div class="col-sm-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Filter</button>
            </div>
            <div class="col-sm-2 d-grid">
                <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.Payments.Any())
        {
            <div class="empty-state">
                <i class="bi bi-credit-card-2-front"></i>
                <h5>No payments found</h5>
                <p class="mb-3">Get started by recording your first payment.</p>
                <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Payment</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Hotel / Room</th>
                            <th class="text-end">Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Transaction Ref</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td><strong>#@p.PaymentID</strong></td>
                                <td>@p.CustomerName</td>
                                <td>
                                    <div class="fw-semibold">@p.HotelName</div>
                                    <small class="text-muted">Room @p.RoomNumber</small>
                                </td>
                                <td class="text-end"><span class="fw-semibold">@p.Amount.ToString("C2")</span></td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-@(p.PaymentMethod switch { "Cash" => "cash", "CreditCard" => "credit-card", "DebitCard" => "credit-card-2-front", "OnlinePayment" => "globe", "BankTransfer" => "bank", _ => "wallet2" })"></i>
                                        @p.PaymentMethod
                                    </span>
                                </td>
                                <td><span class="badge @StatusUi.PaymentBadge(p.PaymentStatus)">@p.PaymentStatus</span></td>
                                <td><code class="small">@(p.TransactionReference ?? "—")</code></td>
                                <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <a asp-page="./Details" asp-route-id="@p.PaymentID" class="btn btn-icon btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                    <a asp-page="./Edit" asp-route-id="@p.PaymentID" class="btn btn-icon btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-page="./Delete" asp-route-id="@p.PaymentID" class="btn btn-icon btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <partial name="_Pagination" />
        </div>
    }
</div>
