@page
@model HotelReservation.Web.Pages.Reports.MonthlyRevenueModel
@{
    ViewData["Title"] = "Monthly Revenue Report";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Reports\">Reports</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Monthly Revenue</li>";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-graph-up-arrow text-primary"></i> Monthly Revenue Report</h1>
        <p class="text-muted mb-0">Yearly revenue breakdown by month</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer"></i> Print</button>
        <button onclick="window.print()" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> Export PDF</button>
        <a asp-page-handler="ExportCsv" asp-route-year="@Model.Year" class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
        </a>
        <a asp-page-handler="ExportExcel" asp-route-year="@Model.Year" class="btn btn-info">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-currency-dollar text-success fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-label">Total Revenue</div>
                        <div class="stat-value text-success">@Model.RevenueData.Sum(r => r.Revenue).ToString("C2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-check text-primary fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-label">Total Reservations</div>
                        <div class="stat-value text-primary">@Model.RevenueData.Sum(r => r.ReservationCount)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-receipt text-info fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-label">Avg per Reservation</div>
                        <div class="stat-value text-info">
                            @(Model.RevenueData.Sum(r => r.ReservationCount) > 0
                                ? (Model.RevenueData.Sum(r => r.Revenue) / Model.RevenueData.Sum(r => r.ReservationCount)).ToString("C2")
                                : "$0.00")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-funnel text-primary"></i> Filters</h5>
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="year" class="form-select form-select-sm" asp-items="Model.Years">
                    <option value="">All Years</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel"></i> Generate</button>
                <a asp-page="./MonthlyRevenue" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i> Clear</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.RevenueData.Any())
        {
            <div class="empty-state">
                <i class="bi bi-bar-chart"></i>
                <h5>No revenue data</h5>
                <p class="mb-0">Select a year and generate the report to see results.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th class="text-center">Reservations</th>
                            <th class="text-end">Revenue</th>
                            <th class="text-end">Avg Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RevenueData)
                        {
                            <tr>
                                <td class="fw-semibold">@item.MonthName</td>
                                <td class="text-center">
                                    <span class="badge bg-primary bg-opacity-10 text-primary">@item.ReservationCount</span>
                                </td>
                                <td class="text-end fw-semibold">@item.Revenue.ToString("C2")</td>
                                <td class="text-end">@item.AvgReservationValue.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-active">
                            <td class="fw-bold">Total</td>
                            <td class="text-center fw-bold">
                                <span class="badge bg-primary">@Model.RevenueData.Sum(r => r.ReservationCount)</span>
                            </td>
                            <td class="text-end fw-bold">@Model.RevenueData.Sum(r => r.Revenue).ToString("C2")</td>
                            <td class="text-end">—</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
