@page
@model HotelReservation.Web.Pages.Reports.ReservationSummaryModel
@{
    ViewData["Title"] = "Reservation Summary Report";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Reports\">Reports</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Reservation Summary</li>";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-file-earmark-bar-graph text-primary"></i> Reservation Summary Report</h1>
        <p class="text-muted mb-0">Detailed reservation overview with filters</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer"></i> Print</button>
        <button onclick="window.print()" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> Export PDF</button>
        <a asp-page-handler="ExportCsv" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
        </a>
        <a asp-page-handler="ExportExcel" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" class="btn btn-info">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-check text-primary fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-label">Total Reservations</div>
                        <div class="stat-value text-primary">@Model.Reservations.Count</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-currency-dollar text-success fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-label">Total Revenue</div>
                        <div class="stat-value text-success">@Model.Reservations.Sum(r => r.TotalAmount).ToString("C2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-receipt text-info fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-label">Average per Reservation</div>
                        <div class="stat-value text-info">
                            @(Model.Reservations.Count > 0
                                ? (Model.Reservations.Sum(r => r.TotalAmount) / Model.Reservations.Count).ToString("C2")
                                : "$0.00")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-funnel text-primary"></i> Filters</h5>
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@Model.FromDate?.ToString("yyyy-MM-dd")" placeholder="From" />
            </div>
            <div class="col-auto">
                <input type="date" name="toDate" class="form-control form-control-sm" value="@Model.ToDate?.ToString("yyyy-MM-dd")" placeholder="To" />
            </div>
            <div class="col-auto">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Confirmed</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                    <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel"></i> Generate</button>
                <a asp-page="./ReservationSummary" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i> Clear</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.Reservations.Any())
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <h5>No reservations found</h5>
                <p class="mb-0">Adjust your filters and generate the report to see results.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Hotel</th>
                            <th>Room</th>
                            <th>Type</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th class="text-center">Nights</th>
                            <th>Status</th>
                            <th class="text-end">Amount</th>
                            <th>Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Reservations)
                        {
                            <tr>
                                <td><strong>#@item.ReservationID</strong></td>
                                <td class="fw-semibold">@item.CustomerName</td>
                                <td>@item.HotelName</td>
                                <td>@item.RoomNumber</td>
                                <td><span class="badge bg-light text-dark border">@item.RoomType</span></td>
                                <td>@item.CheckInDate.ToShortDateString()</td>
                                <td>@item.CheckOutDate.ToShortDateString()</td>
                                <td class="text-center">
                                    <span class="badge bg-info bg-opacity-10 text-info">@item.StayNights</span>
                                </td>
                                <td>
                                    @{
                                        var sc = item.ReservationStatus switch
                                        {
                                            "Confirmed" => "badge bg-success",
                                            "Pending" => "badge bg-warning text-dark",
                                            "Cancelled" => "badge bg-danger",
                                            "Completed" => "badge bg-secondary",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@sc">@item.ReservationStatus</span>
                                </td>
                                <td class="text-end fw-semibold">@item.TotalAmount.ToString("C2")</td>
                                <td>
                                    @{
                                        var pc = item.PaymentStatus switch
                                        {
                                            "Paid" => "badge bg-success",
                                            "Pending" => "badge bg-warning text-dark",
                                            "Refunded" => "badge bg-danger",
                                            "Partial" => "badge bg-info",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@pc">@(item.PaymentStatus ?? "N/A")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
