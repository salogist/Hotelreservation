@page "{reservationId:int}/{serviceId:int}"
@model HotelReservation.Web.Pages.ReservationServices.DeleteModel
@{
    ViewData["Title"] = "Delete Reservation Service";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-trash"></i> Delete Reservation Service</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house-door"></i></a></li>
                <li class="breadcrumb-item"><a asp-page="./Index">Reservation Services</a></li>
                <li class="breadcrumb-item active" aria-current="page">Delete</li>
            </ol>
        </nav>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    Are you sure you want to delete this service assignment? This action cannot be undone.
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-5">Reservation #</dt>
                    <dd class="col-sm-7"><span class="badge bg-primary badge-rounded">#@Model.Item.ReservationID</span></dd>

                    <dt class="col-sm-5">Customer</dt>
                    <dd class="col-sm-7">@Model.Item.CustomerName</dd>

                    <dt class="col-sm-5">Room</dt>
                    <dd class="col-sm-7">@Model.Item.RoomNumber</dd>

                    <dt class="col-sm-5">Service</dt>
                    <dd class="col-sm-7">@Model.Item.ServiceName</dd>

                    <dt class="col-sm-5">Category</dt>
                    <dd class="col-sm-7">@Model.Item.ServiceCategory</dd>

                    <dt class="col-sm-5">Quantity</dt>
                    <dd class="col-sm-7">@Model.Item.Quantity</dd>

                    <dt class="col-sm-5">Unit Price</dt>
                    <dd class="col-sm-7">@Model.Item.UnitPrice.ToString("C2")</dd>

                    <dt class="col-sm-5">Line Total</dt>
                    <dd class="col-sm-7 fw-bold text-danger fs-5">@Model.Item.LineTotal.ToString("C2")</dd>
                </dl>
            </div>
            <div class="card-footer bg-light">
                <form method="post">
                    <input type="hidden" name="reservationId" value="@Model.Item.ReservationID" />
                    <input type="hidden" name="serviceId" value="@Model.Item.ServiceID" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
