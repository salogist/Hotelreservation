@page "{reservationId:int}/{serviceId:int}"
@model HotelReservation.Web.Pages.ReservationServices.DetailsModel
@{
    ViewData["Title"] = "Reservation Service Details";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-eye"></i> Service Assignment Details</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house-door"></i></a></li>
                <li class="breadcrumb-item"><a asp-page="./Index">Reservation Services</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-reservationId="@Model.Item.ReservationID" asp-route-serviceId="@Model.Item.ServiceID" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Assignment Information</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Reservation ID</label>
                        <div class="fw-bold fs-5"><span class="badge bg-primary badge-rounded">#@Model.Item.ReservationID</span></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Customer Name</label>
                        <div class="fw-bold fs-5">@Model.Item.CustomerName</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Room Number</label>
                        <div class="fw-bold fs-5">@Model.Item.RoomNumber</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Service Name</label>
                        <div class="fw-bold fs-5">@Model.Item.ServiceName</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Service Category</label>
                        <div class="fw-bold fs-5">@Model.Item.ServiceCategory</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Quantity</label>
                        <div class="fw-bold fs-5">@Model.Item.Quantity</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Unit Price</label>
                        <div class="fw-bold fs-5">@Model.Item.UnitPrice.ToString("C2")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted mb-1">Line Total</label>
                        <div class="fw-bold fs-5 text-primary">@Model.Item.LineTotal.ToString("C2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
