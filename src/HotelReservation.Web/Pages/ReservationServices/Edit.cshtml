@page "{reservationId:int}/{serviceId:int}"
@model HotelReservation.Web.Pages.ReservationServices.EditModel
@{
    ViewData["Title"] = "Edit Reservation Service";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-pencil-square"></i> Edit Reservation Service</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house-door"></i></a></li>
                <li class="breadcrumb-item"><a asp-page="./Index">Reservation Services</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <input type="hidden" name="reservationId" value="@Model.ItemDescription.ReservationID" />
                    <input type="hidden" name="serviceId" value="@Model.ItemDescription.ServiceID" />

                    <h6 class="form-section-title"><i class="bi bi-info-circle me-1"></i> Assignment Details</h6>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Reservation</label>
                            <input type="text" class="form-control" value="@Model.ItemDescription.ReservationID" readonly disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Service</label>
                            <input type="text" class="form-control" value="@Model.ItemDescription.ServiceName" readonly disabled />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <input type="text" class="form-control" value="@Model.ItemDescription.ServiceCategory" readonly disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Unit Price</label>
                            <input type="text" class="form-control" value="@Model.ItemDescription.UnitPrice.ToString("C2")" readonly disabled />
                        </div>
                    </div>

                    <h6 class="form-section-title mt-4"><i class="bi bi-pencil me-1"></i> Update Quantity</h6>

                    <div class="mb-4">
                        <label asp-for="Input.Quantity" class="form-label">Quantity</label>
                        <input asp-for="Input.Quantity" class="form-control" type="number" min="1" max="999" />
                        <span asp-validation-for="Input.Quantity" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
