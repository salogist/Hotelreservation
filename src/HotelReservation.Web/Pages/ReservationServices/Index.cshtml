@page
@model HotelReservation.Web.Pages.ReservationServices.IndexModel
@{
    ViewData["Title"] = "Reservation Services";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-link-45deg"></i> Reservation Services</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house-door"></i></a></li>
                <li class="breadcrumb-item active" aria-current="page">Reservation Services</li>
            </ol>
        </nav>
    </div>
    <div>
        <a asp-page="./Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add Service
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-stat">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Items.Count</div>
                    <div class="stat-label">Total Entries</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Items.Sum(i => i.LineTotal).ToString("C0")</div>
                    <div class="stat-label">Total Revenue</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Items.Select(i => i.ReservationID).Distinct().Count()</div>
                    <div class="stat-label">Reservations</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Items.Sum(i => i.Quantity)</div>
                    <div class="stat-label">Total Items</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter</h6>
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="number" name="reservationId" value="@Model.ReservationIdFilter" class="form-control form-control-sm" placeholder="Reservation ID" style="width: 160px;" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i> Filter</button>
            @if (Model.ReservationIdFilter.HasValue)
            {
                <a asp-page="./Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
            }
        </form>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Reservation #</th>
                            <th>Customer</th>
                            <th>Room</th>
                            <th>Service</th>
                            <th>Category</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Line Total</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><span class="badge bg-primary badge-rounded">#@item.ReservationID</span></td>
                                <td>@item.CustomerName</td>
                                <td>@item.RoomNumber</td>
                                <td>@item.ServiceName</td>
                                <td>@item.ServiceCategory</td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("C2")</td>
                                <td class="text-end fw-bold">@item.LineTotal.ToString("C2")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-page="./Edit" asp-route-reservationId="@item.ReservationID" asp-route-serviceId="@item.ServiceID" class="btn btn-icon btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="./Details" asp-route-reservationId="@item.ReservationID" asp-route-serviceId="@item.ServiceID" class="btn btn-icon btn-outline-info" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="./Delete" asp-route-reservationId="@item.ReservationID" asp-route-serviceId="@item.ServiceID" class="btn btn-icon btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h5>No reservation services found</h5>
                <p>Try adjusting your filter or add a new service assignment.</p>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <partial name="_Pagination" />
        </div>
    }
</div>
