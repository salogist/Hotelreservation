@page
@model HotelReservation.Web.Pages.Reservations.EditModel
@{
    ViewData["Title"] = "Edit Reservation";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Reservations\">Reservations</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Edit</li>";
}

<div class="page-header">
    <h1><i class="bi bi-pencil-square text-primary"></i> Edit Reservation #@Model.Reservation.ReservationID</h1>
</div>

<form method="post">
    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <input asp-for="Reservation.ReservationID" type="hidden" />

            <h6 class="form-section-title"><i class="bi bi-person"></i> Guest Information</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Reservation.CustomerID" class="form-label"></label>
                    <select asp-for="Reservation.CustomerID" class="form-select" asp-items="Model.Customers">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="Reservation.CustomerID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Reservation.EmployeeID" class="form-label"></label>
                    <select asp-for="Reservation.EmployeeID" class="form-select" asp-items="Model.Employees">
                        <option value="">-- Select Employee --</option>
                    </select>
                    <span asp-validation-for="Reservation.EmployeeID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Reservation.ReservationStatus" class="form-label"></label>
                    <select asp-for="Reservation.ReservationStatus" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Completed">Completed</option>
                    </select>
                    <span asp-validation-for="Reservation.ReservationStatus" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="form-section-title"><i class="bi bi-door-open"></i> Stay Details</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Reservation.RoomID" class="form-label"></label>
                    <select asp-for="Reservation.RoomID" class="form-select" asp-items="Model.Rooms">
                        <option value="">-- Select Room --</option>
                    </select>
                    <span asp-validation-for="Reservation.RoomID" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Reservation.CheckInDate" class="form-label"></label>
                    <input asp-for="Reservation.CheckInDate" class="form-control" type="date" />
                    <span asp-validation-for="Reservation.CheckInDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Reservation.CheckOutDate" class="form-label"></label>
                    <input asp-for="Reservation.CheckOutDate" class="form-control" type="date" />
                    <span asp-validation-for="Reservation.CheckOutDate" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="form-section-title"><i class="bi bi-people"></i> Occupancy</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Reservation.Adults" class="form-label"></label>
                    <input asp-for="Reservation.Adults" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Reservation.Adults" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Reservation.Children" class="form-label"></label>
                    <input asp-for="Reservation.Children" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Reservation.Children" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="form-section-title"><i class="bi bi-chat-left-text"></i> Special Requests</h6>
            <div class="row g-3">
                <div class="col-12">
                    <textarea asp-for="Reservation.SpecialRequests" class="form-control" rows="3" placeholder="Any special requests or notes..."></textarea>
                    <span asp-validation-for="Reservation.SpecialRequests" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light d-flex justify-content-end gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
