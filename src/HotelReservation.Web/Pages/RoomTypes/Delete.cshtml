@page
@model HotelReservation.Web.Pages.RoomTypes.DeleteModel
@{
    ViewData["Title"] = "Delete Room Type";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/RoomTypes\">Room Types</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Delete</li>";
}

@if (Model.RoomType == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Room type not found.</p></div>
    return;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h5>
            </div>
            <div class="card-body">
                <p class="fs-5">Are you sure you want to delete room type <strong>@Model.RoomType.TypeName</strong>?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-info-circle"></i> It currently has <strong>@Model.RoomType.RoomCount room(s)</strong>. If rooms use this type, deletion will be blocked.
                </div>
                <form method="post">
                    <input type="hidden" name="id" value="@Model.RoomType.RoomTypeID" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
