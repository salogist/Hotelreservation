@page
@model HotelReservation.Web.Pages.RoomTypes.DetailsModel
@{
    ViewData["Title"] = "Room Type Details";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/RoomTypes\">Room Types</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Details</li>";
}

@if (Model.RoomType == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Room type not found.</p></div>
    return;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-diagram-2 text-primary"></i> @Model.RoomType.TypeName</h1>
        <p class="text-muted mb-0">@Model.RoomType.Description</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.RoomType.RoomTypeID" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <i class="bi bi-people text-primary fs-1"></i>
                <div class="stat-value">@Model.RoomType.Capacity</div>
                <div class="stat-label">Guest Capacity</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <i class="bi bi-cash-coin text-success fs-1"></i>
                <div class="stat-value text-success">@Model.RoomType.BasePrice.ToString("C")</div>
                <div class="stat-label">Base Price / Night</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <i class="bi bi-door-open text-info fs-1"></i>
                <div class="stat-value text-info">@Model.RoomType.RoomCount</div>
                <div class="stat-label">Rooms of this Type</div>
            </div>
        </div>
    </div>
</div>
