@page
@model HotelReservation.Web.Pages.RoomTypes.EditModel
@{
    ViewData["Title"] = "Edit Room Type";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/RoomTypes\">Room Types</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Edit</li>";
}

<div class="page-header">
    <h1><i class="bi bi-pencil-square text-primary"></i> Edit Room Type</h1>
</div>

<form method="post">
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="RoomType.TypeName" class="form-label"></label>
                    <input asp-for="RoomType.TypeName" class="form-control" />
                    <span asp-validation-for="RoomType.TypeName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="RoomType.Capacity" class="form-label"></label>
                    <input asp-for="RoomType.Capacity" class="form-control" type="number" min="1" max="20" />
                    <span asp-validation-for="RoomType.Capacity" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="RoomType.BasePrice" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="RoomType.BasePrice" class="form-control" type="number" step="0.01" min="0.01" />
                    </div>
                    <span asp-validation-for="RoomType.BasePrice" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="RoomType.Description" class="form-label"></label>
                    <textarea asp-for="RoomType.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="RoomType.Description" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light d-flex justify-content-end gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
