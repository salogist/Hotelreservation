@page
@model HotelReservation.Web.Pages.RoomTypes.IndexModel
@{
    ViewData["Title"] = "Room Types";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item active\" aria-current=\"page\">Room Types</li>";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-diagram-3 text-primary"></i> Room Types</h1>
        <p class="text-muted mb-0">@Model.TotalItems room type(s) configured</p>
    </div>
    <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Room Type</a>
</div>

<div class="card table-card mb-4">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-7">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by type name or description..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-sm-3">
                <label class="form-label">Sort by</label>
                <select name="sortOrder" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Name (A-Z)</option>
                    <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Name (Z-A)</option>
                    <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Price (High-Low)</option>
                    <option value="capacity" selected="@(Model.SortOrder == "capacity")">Capacity</option>
                </select>
            </div>
            <div class="col-sm-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Apply</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.RoomTypes.Any())
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-inboxes"></i>
            <h5>No room types yet</h5>
            <p class="mb-3">Define room categories (Standard, Deluxe, Suite, etc.) to classify your rooms.</p>
            <a asp-page="./Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Room Type</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var rt in Model.RoomTypes)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card card-stat h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-0">@rt.TypeName</h5>
                                <small class="text-muted">@rt.Description</small>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary">@rt.RoomCount rooms</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small"><i class="bi bi-people"></i> Capacity</span>
                                <div class="fw-bold">@rt.Capacity guests</div>
                            </div>
                            <div class="text-end">
                                <span class="text-muted small">Base Price</span>
                                <div class="fw-bold text-success fs-5">@rt.BasePrice.ToString("C")<small class="text-muted fw-normal">/night</small></div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-end gap-1">
                        <a asp-page="./Details" asp-route-id="@rt.RoomTypeID" class="btn btn-icon btn-outline-info"><i class="bi bi-eye"></i></a>
                        <a asp-page="./Edit" asp-route-id="@rt.RoomTypeID" class="btn btn-icon btn-outline-warning"><i class="bi bi-pencil"></i></a>
                        <a asp-page="./Delete" asp-route-id="@rt.RoomTypeID" class="btn btn-icon btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white mt-3">
            <partial name="_Pagination" />
        </div>
    }
}
