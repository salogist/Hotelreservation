@page
@model HotelReservation.Web.Pages.Rooms.DetailsModel
@using HotelReservation.Web.Helpers
@{
    ViewData["Title"] = "Room Details";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Rooms\">Rooms</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Details</li>";
}

@if (Model.Room == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Room not found.</p></div>
    return;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-door-open text-primary"></i> Room #@Model.Room.RoomNumber</h1>
        <p class="text-muted mb-0"><i class="bi bi-buildings"></i> @Model.Room.HotelName &middot; @Model.Room.RoomTypeName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Room.RoomID" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-card-list text-primary"></i> Room Information</h5></div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Hotel</div>
                    <div class="col-sm-8"><i class="bi bi-buildings"></i> @Model.Room.HotelName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Room Type</div>
                    <div class="col-sm-8"><i class="bi bi-diagram-3"></i> @Model.Room.RoomTypeName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Room Number</div>
                    <div class="col-sm-8"><strong>#@Model.Room.RoomNumber</strong></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Base Price</div>
                    <div class="col-sm-8"><i class="bi bi-currency-dollar"></i> @Model.Room.BasePrice.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-value text-primary">@Model.Room.FloorNumber</div>
                        <div class="stat-label">Floor</div>
                    </div>
                    <div class="col-6">
                        <div class="stat-value"><span class="badge @StatusUi.RoomBadge(Model.Room.Status) fs-6">@Model.Room.Status</span></div>
                        <div class="stat-label">Status</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <i class="bi bi-balcony @(Model.Room.HasBalcony ? "text-success fs-4" : "text-muted fs-4")"></i>
                        <div class="stat-label mt-1">Balcony</div>
                        <div class="fw-semibold @(Model.Room.HasBalcony ? "text-success" : "text-muted")">@(Model.Room.HasBalcony ? "Yes" : "No")</div>
                    </div>
                    <div class="col-6">
                        <i class="bi bi-water @(Model.Room.HasSeaView ? "text-success fs-4" : "text-muted fs-4")"></i>
                        <div class="stat-label mt-1">Sea View</div>
                        <div class="fw-semibold @(Model.Room.HasSeaView ? "text-success" : "text-muted")">@(Model.Room.HasSeaView ? "Yes" : "No")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0">Quick Actions</h6></div>
            <div class="card-body d-grid gap-2">
                <a asp-page="./Edit" asp-route-id="@Model.Room.RoomID" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i> Edit Room</a>
                <a asp-page="./Delete" asp-route-id="@Model.Room.RoomID" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete Room</a>
            </div>
        </div>
    </div>
</div>
