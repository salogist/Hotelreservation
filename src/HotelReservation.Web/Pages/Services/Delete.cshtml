@page
@model HotelReservation.Web.Pages.Services.DeleteModel
@{
    ViewData["Title"] = "Delete Service";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Services\">Services</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Delete</li>";
}

@if (Model.Service == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Service not found.</p></div>
    return;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h5>
            </div>
            <div class="card-body">
                <p class="fs-5">Are you sure you want to delete <strong>@Model.Service.ServiceName</strong>?</p>
                <p class="text-muted">Category: <strong>@Model.Service.Category</strong> | Price: <strong>@Model.Service.Price.ToString("C2")</strong></p>
                <div class="alert alert-warning">
                    <i class="bi bi-info-circle"></i> This action cannot be undone. If the service is linked to reservations, deletion will be blocked.
                </div>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Service.ServiceID" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete Permanently</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
