@page
@model HotelReservation.Web.Pages.Services.DetailsModel
@{
    ViewData["Title"] = "Service Details";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Services\">Services</a></li><li class=\"breadcrumb-item active\" aria-current=\"page\">Details</li>";
}

@if (Model.Service == null)
{
    <div class="empty-state"><i class="bi bi-exclamation-circle"></i><p>Service not found.</p></div>
    return;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-gear text-primary"></i> @Model.Service.ServiceName</h1>
        <p class="text-muted mb-0">Category: <span class="badge bg-info bg-opacity-10 text-info">@Model.Service.Category</span></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Service.ServiceID" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-card-list text-primary"></i> Service Information</h5></div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Service Name</div>
                    <div class="col-sm-8 fw-semibold">@Model.Service.ServiceName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Category</div>
                    <div class="col-sm-8"><span class="badge bg-info bg-opacity-10 text-info">@Model.Service.Category</span></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Available</div>
                    <div class="col-sm-8">
                        @if (Model.Service.IsAvailable)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> No</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Description</div>
                    <div class="col-sm-8">@(Model.Service.Description ?? "No description provided.")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <div class="stat-value text-primary">@Model.Service.Price.ToString("C2")</div>
                <div class="stat-label">Price</div>
            </div>
        </div>
    </div>
</div>
