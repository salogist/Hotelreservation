<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Reservation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar no-print" id="sidebar">
            <a class="brand" href="/">
                <span class="brand-icon"><i class="bi bi-building-fill"></i></span>
                <span>Hotel<span class="text-warning">Pro</span></span>
            </a>

            <nav>
                <div class="nav-section">Main</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Reservations/Index"><i class="bi bi-calendar-check"></i> Reservations</a>
                    </li>
                </ul>

                <div class="nav-section">Properties</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Hotels/Index"><i class="bi bi-buildings"></i> Hotels</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/RoomTypes/Index"><i class="bi bi-diagram-3"></i> Room Types</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Rooms/Index"><i class="bi bi-door-open"></i> Rooms</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Services/Index"><i class="bi bi-cone-striped"></i> Services</a>
                    </li>
                </ul>

                <div class="nav-section">People</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Customers/Index"><i class="bi bi-people"></i> Customers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Employees/Index"><i class="bi bi-person-badge"></i> Employees</a>
                    </li>
                </ul>

                <div class="nav-section">Finance</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Payments/Index"><i class="bi bi-credit-card"></i> Payments</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/ReservationServices/Index"><i class="bi bi-bag-plus"></i> Reservation Services</a>
                    </li>
                </ul>

                <div class="nav-section">Insights</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Reports/Index"><i class="bi bi-bar-chart-line"></i> Reports</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Reports/ReservationSummary"><i class="bi bi-file-earmark-bar-graph"></i> Reservation Summary</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Reports/MonthlyRevenue"><i class="bi bi-graph-up-arrow"></i> Monthly Revenue</a>
                    </li>
                </ul>

                <div class="nav-section">System</div>
                <ul class="nav flex-column">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-circle"></i> Profile</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="/swagger" target="_blank"><i class="bi bi-code-square"></i> API Docs</a>
                    </li>
                </ul>
            </nav>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Main column -->
        <div class="main-area">
            <header class="topbar no-print">
                <button class="toggle-btn" type="button" id="sidebarToggle" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <nav aria-label="breadcrumb" class="d-none d-md-block">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
                        @if (ViewData["Breadcrumb"] != null)
                        {
                            @Html.Raw(ViewData["Breadcrumb"])
                        }
                        else
                        {
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        }
                    </ol>
                </nav>
                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="badge bg-light text-dark border px-2 py-2">
                            <i class="bi bi-person-check"></i> @User.Identity?.Name
                        </span>
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">
                            <i class="bi bi-person-plus"></i> Register
                        </a>
                    }
                </div>
            </header>

            <main class="content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>

            <footer class="app-footer no-print">
                <div>
                    &copy; @DateTime.Now.Year Hotel Reservation Management System &middot;
                    <span class="text-muted">Built with ASP.NET Core 8</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
