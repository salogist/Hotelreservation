@*
    Reusable pagination control.
    Expects: CurrentPage, TotalPages, and preserves route values via ViewData["RouteValues"] (IDictionary<string,string>) optional.
*@
@{
    int current = (int)ViewData["CurrentPage"]!;
    int total = (int)ViewData["TotalPages"]!;
    var routeValues = ViewData["RouteValues"] as IDictionary<string, string> ?? new Dictionary<string, string>();

    if (total <= 1) { return; }

    // Build a hidden form-friendly set of query inputs anchor hrefs
    string BuildHref(int page)
    {
        var query = new List<string>();
        foreach (var kv in routeValues)
        {
            if (kv.Key.Equals("pageNumber", StringComparison.OrdinalIgnoreCase)) continue;
            query.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}");
        }
        query.Add($"pageNumber={page}");
        return "?" + string.Join("&", query);
    }

    // Compute a window of pages around the current page
    int start = Math.Max(1, current - 2);
    int end = Math.Min(total, start + 4);
    start = Math.Max(1, end - 4);
}

<nav aria-label="Page navigation" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <small class="text-muted">
        Page @current of @total
    </small>
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(current == 1 ? "disabled" : "")">
            <a class="page-link" href="@(current > 1 ? BuildHref(current - 1) : "#")" aria-label="Previous">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>
        @if (start > 1)
        {
            <li class="page-item"><a class="page-link" href="@BuildHref(1)">1</a></li>
            @if (start > 2)
            {
                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            }
        }
        @for (int p = start; p <= end; p++)
        {
            <li class="page-item @(p == current ? "active" : "")">
                <a class="page-link" href="@BuildHref(p)">@p</a>
            </li>
        }
        @if (end < total)
        {
            @if (end < total - 1)
            {
                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            }
            <li class="page-item"><a class="page-link" href="@BuildHref(total)">@total</a></li>
        }
        <li class="page-item @(current == total ? "disabled" : "")">
            <a class="page-link" href="@(current < total ? BuildHref(current + 1) : "#")" aria-label="Next">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav>
